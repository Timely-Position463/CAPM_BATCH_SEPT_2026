###
GET http://localhost:4004/odata/v4/catalog/ProductsSrv
### Create Employee
POST http://localhost:4004/odata/v4/catalog/EmployeeSrv
Content-Type: application/json
 
{
    "ID": "2a5776ec-e711-4c11-a92a-2da5b46c40b6",
    "accountNumber":null,
    "bankId": null,
    "email":null,
    "gender":"M",
    "language":"E",
    "loginName":"RAMAM",
    "nameFirst":" Sita Ram",
    "nameInitials":null,
    "nameLast":"Murthy",
    "nameMiddle":null,
    "phoneNumber":"(+1) 9898989898",
    "salaryAmount": "45000.00",
    "Currency_code" : "EUR"
}

### Update EmployeeSrv in salary to check .before()
PUT   http://localhost:4004/odata/v4/catalog/EmployeeSrv/2a5776ec-e711-4c11-a92a-2da5b46c40b2
Content-Type: application/json

{
    "salaryAmount": "9705000.00",
    "Currency_code": "USD"
}

### Update EmployeeSrv
POST http://localhost:4004/odata/v4/catalog/updateEmployee
Content-Type: application/json

{
    "ID": "2a5776ec-e711-4c11-a92a-2da5b46c40b2",
    "salaryAmount": "50000.00",
    "Currency_code": "USD"
}

### Delete Employee
POST http://localhost:4004/odata/v4/catalog/deleteEmployee
Content-Type: application/json

{
    "ID": "2a5776ec-e711-4c11-a92a-2da5b46c40b2"
}


