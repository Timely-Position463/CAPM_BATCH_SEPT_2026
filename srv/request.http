### Returns Products
GET http://localhost:4004/odata/v4/catalog/ProductsSrv

### Create Products
POST http://localhost:4004/odata/v4/catalog/createProduct
Content-Type: application/json

{
  "NODE_KEY": "111234111-5422-3333-4444-09182734",
  "PRODUCT_ID": "PRD5001",
  "TYPE_CODE": "FA",
  "CATEGORY": "Furniture",
  "DESCRIPTION": "Office Bench",
  "TAX_TARIF_CODE": 15,
  "MEASURE_UNIT": "EA",
  "WEIGHT_MEASURE": 25.50,
  "WEIGHT_UNIT": "KG",
  "PRICE": 7500.00,
  "CURRENCY_CODE": "INR",
  "WIDTH": 120.00,
  "DEPTH": 60.00,
  "HEIGHT": 75.00,
  "DIM_UNIT": "CM"
}   

# Update Product
POST http://localhost:4004/odata/v4/catalog/update

### Delete Product
POST http://localhost:4004/odata/v4/catalog/deleteProduct
Content-Type: application/json

{
    "NODE_KEY":"111234111-5422-3333-4444-09182734"
}

### get all product data 
GET http://localhost:4004/odata/v4/catalog/ProductsSrv


### get all product data count
GET http://localhost:4004/odata/v4/catalog/ProductsSrv/$count

### get all product data count of first 10 values
GET http://localhost:4004/odata/v4/catalog/ProductsSrv?$top=10


### get all product data with specific properties
GET http://localhost:4004/odata/v4/catalog/ProductsSrv?$filter=CATEGORY eq 'Notebooks'& $filter=WEIGHT_MEASURE eq '4.50'

### get specific details of the  product data
GET http://localhost:4004/odata/v4/catalog/ProductsSrv?$select=PRODUCT_ID,DESCRIPTION,CATEGORY,PRICE

### get sorted data 
GET http://localhost:4004/odata/v4/catalog/ProductsSrv?$orderby=PRICE asc&$top=10


### to get data of a single product using its key
GET http://localhost:4004/odata/v4/catalog/ProductsSrv('74867AD200E41EDBA5D8B06B26EB6052')/PRODUCT_ID

###
GET http://localhost:4004/odata/v4/catalog/ProductsSrv('74867AD200E41EDBA5D8B06B26EB6052')/PRODUCT_ID/$value

### expand items
GET http://localhost:4004/odata/v4/catalog/PurchaseOrderSrv?$expand=Items

###
https://services.odata.org/V4/Northwind/Northwind.svc/Employees?$select=FirstName,LastName,Address,City,Region&$filter=Country eq 'USA'


